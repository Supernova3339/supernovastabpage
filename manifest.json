{
  "manifest_version": 3,
  "name": "Supernova's Tab Page",
  "description": "This is my custom tab page extension I built to increase my productivity.",
  "version": "1.1.0",
  "permissions": [
    "storage",
    "topSites"
  ],
  "host_permissions": [
    "https://api.ip.sb/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://zenquotes-proxy.supernova3339.workers.dev/*",
    "https://t1.gstatic.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
